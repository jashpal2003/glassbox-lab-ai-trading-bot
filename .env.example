# Alpaca Paper Trading Credentials (Level 3 Options enabled)
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Primary LLM - Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Secondary / Fallback LLM - OpenRouter
#
# Strongly recommended. Every LLM feature (Intent generation, post-trade reflection, and the
# copilot chat) tries Gemini first and then falls back to OpenRouter automatically. Without a
# second provider, an exhausted or rate-limited Gemini key drops the whole system onto its
# deterministic rules - safe by design, but the AI panels will produce nothing.
#
# Get a key at https://openrouter.ai/keys. OPENROUTER_MODEL accepts any model slug OpenRouter
# lists (e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, google/gemini-flash-1.5, or one
# of the free ":free" models).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# System Configuration
PORT=8000
HOST=0.0.0.0
RECONCILIATION_INTERVAL_SECONDS=30
